OPENAI_API_KEY=
SENSORPUSH_EMAIL=
SENSORPUSH_PASSWORD=
# Phase 6: Serper.dev — Google SERP API for price/retailer discovery (serper.dev). The free
# allowance is a one-time 2,500-credit signup grant, not a monthly quota — see CLAUDE.md §15
# for the current billing state (a paid Starter pack, exhausted-free-tier correction, 2026-08-19).
SERPER_API_KEY=
# Phase 1: Google Sheets backend (legacy — can be left empty from Phase 5 onward)
GOOGLE_SHEETS_CREDENTIALS=   # Absolute path to service account JSON file
GOOGLE_SHEETS_SPREADSHEET_ID=
# Phase 13 (optional locally). Empty DEVICE_TOKENS = the local backend needs no token.
# In the cloud it is a Fly secret: comma-separated name:token pairs (see docs/ops/runbook.md).
DEVICE_TOKENS=
# Run the web app (Vite) against the cloud backend: its https://<app>.fly.dev URL and this
# machine's device token. Used only by web/vite.config.ts's dev proxy; never in the bundle.
WINE_API_TARGET=
WINE_ACCESS_KEY=
