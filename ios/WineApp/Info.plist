<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged with the build-setting-generated Info.plist (GENERATE_INFOPLIST_FILE).
	     Only keys with no INFOPLIST_KEY_ equivalent live here. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Phase 12 is LAN-only (D5): the backend is plain HTTP on the local network. -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- Domine (display) / Work Sans (body), the Phase 11.1 type pair. Variable
	     fonts from google/fonts, SIL OFL 1.1 — licences alongside in Fonts/. -->
	<key>UIAppFonts</key>
	<array>
		<string>Domine-Variable.ttf</string>
		<string>WorkSans-Variable.ttf</string>
	</array>
	<key>NSLocalNetworkUsageDescription</key>
	<string>The app talks to your wine backend running on this network.</string>
</dict>
</plist>
